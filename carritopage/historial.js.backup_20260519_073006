  });
}

function filtrarVentas(terminoBusqueda) {
  const termino = terminoBusqueda.toLowerCase();
  return ventasActuales.filter((venta) => {
    const ticket = String(venta.id).slice(-6);
    const fecha = String(venta.fecha || "").toLowerCase();
    return ticket.includes(termino) || fecha.includes(termino);
  });
}

function ordenarVentas(ventas) {
  return [...ventas].sort((a, b) => ordenAscendente ? obtenerFechaVenta(a) - obtenerFechaVenta(b) : obtenerFechaVenta(b) - obtenerFechaVenta(a));
}

async function enviarAPapelera(idVenta) {
  const ventaAEnviar = ventasActuales.find((v) => String(v.id) === String(idVenta));
  if (!ventaAEnviar) return;

  ventasEliminadas.push({
    ...ventaAEnviar,
    fechaEliminacion: new Date().toISOString()
  });
  localStorage.setItem(PAPELERA_KEY, JSON.stringify(ventasEliminadas));

  // Remover de ventas activas si es necesario
  if (window.Backend && window.Backend.isEnabled && window.Backend.isEnabled()) {
    try {
      await window.Backend.delete(`ventas/${idVenta}`);
    } catch (err) {
      console.warn("No se pudo eliminar del backend:", err);
    }
  }

  await cargarVentas();
  renderizarHistorial(ordenarVentas(ventasActuales));
  mostrarNotificacion("success", "Venta a papelera", "La venta fue movida a la papelera.");
}

async function eliminarDefinitivo(idVenta) {
  ventasEliminadas = ventasEliminadas.filter((v) => String(v.id) !== String(idVenta));
  localStorage.setItem(PAPELERA_KEY, JSON.stringify(ventasEliminadas));
  renderizarPapelera();
  mostrarNotificacion("success", "Eliminado", "El registro ha sido eliminado permanentemente.");
}

function recuperarVenta(idVenta) {
  const ventaARecuperar = ventasEliminadas.find((v) => String(v.id) === String(idVenta));
  if (!ventaARecuperar) return;

  // Remover de eliminadas
  ventasEliminadas = ventasEliminadas.filter((v) => String(v.id) !== String(idVenta));
  localStorage.setItem(PAPELERA_KEY, JSON.stringify(ventasEliminadas));

  // Añadir a activas
  const ventaRecuperada = { ...ventaARecuperar };
  delete ventaRecuperada.fechaEliminacion;
  ventasActuales.push(ventaRecuperada);

  renderizarPapelera();
  mostrarNotificacion("success", "Venta recuperada", "La venta ha sido restaurada al historial.");
}

function mostrarNotificacion(tipo, titulo, mensaje) {
  const notification = document.createElement("div");
  notification.className = `notification notification-${tipo}`;
  notification.innerHTML = `<strong>${titulo}:</strong> ${mensaje}`;
  notification.style.cssText = `
    position: fixed;
    top: 20px;
    right: 20px;
    background: ${tipo === "success" ? "#d4edda" : "#f8d7da"};
    border: 1px solid ${tipo === "success" ? "#c3e6cb" : "#f5c6cb"};
    color: ${tipo === "success" ? "#155724" : "#721c24"};
    padding: 15px 20px;
    border-radius: 8px;
    z-index: 9999;
  `;
  document.body.appendChild(notification);
  setTimeout(() => notification.remove(), 3000);
}

